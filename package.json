{
  "name": "codex-context-plugin",
  "version": "0.7.0",
  "description": "Codex plugin that shows what fills a thread's context and what to fix: skills catalog, AGENTS.md, tools and the conversation.",
  "license": "MIT",
  "author": "Dmitry Nehaychik (https://github.com/nnixaa)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rongjoker/codex-context-plugin.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/activity.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gallery": "esbuild preview/gallery.ts --bundle --platform=node --format=esm --log-level=warning --outfile=preview/.gallery.mjs && node preview/.gallery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "gpt-tokenizer": "^4.0.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
